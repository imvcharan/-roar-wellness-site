CMS_ADMIN_PASSWORD=replace-with-a-strong-unique-password
CMS_SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional; defaults to data/cms.sqlite
# CMS_DATABASE_PATH=C:\roar-data\cms.sqlite
# Optional; defaults to data/media
# CMS_MEDIA_DIRECTORY=C:\roar-data\media

# Configure these on the server before scheduling automated off-site backups.
# Generate the encryption key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep this key in a secret manager separately from the S3 bucket and CMS_SESSION_SECRET.
# CMS_BACKUP_ENCRYPTION_KEY=
# CMS_BACKUP_S3_BUCKET=
# CMS_BACKUP_S3_REGION=
# Optional for S3-compatible services such as a non-AWS object store.
# CMS_BACKUP_S3_ENDPOINT=
# CMS_BACKUP_S3_PREFIX=roar-cms
# CMS_BACKUP_S3_POINTER_KEY=roar-cms/latest.json
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# CMS_BACKUP_MAX_AGE_HOURS=26

# Optional SMTP-based new-enquiry alerts. Alerts include only a link to the CMS inbox.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# ENQUIRY_ALERT_FROM=
# ENQUIRY_ALERT_TO=
# CMS_PUBLIC_URL=https://www.roarwellness.org
